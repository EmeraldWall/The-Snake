<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheSnake.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheSnake.Controls"
    xmlns:ui="clr-namespace:TheSnake.Ui"
    Style="{StaticResource PageStyle}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,28,20,20" Spacing="14" MaximumWidthRequest="560">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="THE SNAKE" FontFamily="OpenSansSemibold" FontSize="34" CharacterSpacing="5" TextColor="{DynamicResource Accent}" SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="Classic Snake, rebuilt for today's phones" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="&#x2699;" FontSize="22" Style="{StaticResource IconButton}" VerticalOptions="Center" Clicked="OnSettings" SemanticProperties.Description="Settings" />
                </Grid>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Label x:Name="LevelLabel" Text="Level 1" Style="{StaticResource Heading}" />
                        <Label x:Name="StreakLabel" Grid.Column="1" Style="{StaticResource MutedText}" VerticalOptions="Center" />
                        <ProgressBar x:Name="XpBar" Grid.Row="1" Grid.ColumnSpan="2" />
                    </Grid>
                </Border>

                <Button x:Name="PlayButton" Text="PLAY" FontSize="24" HeightRequest="76" CornerRadius="24" Style="{StaticResource PrimaryButton}" Clicked="OnPlay" SemanticProperties.Description="Play Endless mode" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource Card}" MinimumHeightRequest="92">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDaily" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Daily Run" Style="{StaticResource Heading}" />
                            <Label x:Name="DailySub" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" MinimumHeightRequest="92">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnWeekly" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Weekly Arena" Style="{StaticResource Heading}" />
                            <Label x:Name="WeeklySub" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" MinimumHeightRequest="92">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRetro" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Retro 97" Style="{StaticResource Heading}" />
                            <Label x:Name="RetroSub" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" MinimumHeightRequest="92">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChallenge" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Challenge" Style="{StaticResource Heading}" />
                            <Label Text="Play a friend's code" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Today's missions" Style="{StaticResource Heading}" />
                        <VerticalStackLayout x:Name="MissionsList" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Best scores" Style="{StaticResource Heading}" />
                        <Label x:Name="BestLabel" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Themes and look" Style="{StaticResource SecondaryButton}" Clicked="OnSettings" />
                    <Button x:Name="RemoveAdsButton" Grid.Column="1" Text="Remove ads" Style="{StaticResource SecondaryButton}" Clicked="OnRemoveAds" />
                </Grid>

                <Label Text="Nearby Battle and Google Play leaderboards are coming in a later build." Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:AdStrip Grid.Row="1" />

        <ui:SheetHost x:Name="SheetLayer" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
