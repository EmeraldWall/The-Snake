<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheSnake.Views.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheSnake.Controls"
    xmlns:ui="clr-namespace:TheSnake.Ui"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <Style x:Key="PadButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="WidthRequest" Value="64" />
            <Setter Property="HeightRequest" Value="64" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextColor" Value="{DynamicResource Accent}" />
        </Style>
    </ContentPage.Resources>

    <!-- Rows: HUD, arena, D pad, 24 dp gap with divider, ad strip (spec 9.1). -->
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

        <Grid Padding="18,10,10,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                <Label x:Name="ScoreLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="28" TextColor="{DynamicResource Text}" />
                <Label x:Name="BestLabel" Style="{StaticResource MutedText}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                <Grid x:Name="ComboRow" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label x:Name="ComboLabel" Text="x1" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{DynamicResource Highlight}" WidthRequest="34" />
                    <ProgressBar x:Name="ComboBar" Grid.Column="1" ProgressColor="{DynamicResource Highlight}" VerticalOptions="Center" />
                </Grid>
                <Grid x:Name="PowerRow" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False">
                    <Label x:Name="PowerLabel" FontSize="12" TextColor="{DynamicResource Text}" WidthRequest="74" />
                    <ProgressBar x:Name="PowerBar" Grid.Column="1" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="II" Style="{StaticResource IconButton}" Clicked="OnPauseClicked" SemanticProperties.Description="Pause" />
        </Grid>

        <Grid Grid.Row="1" Padding="8,0">
            <GraphicsView
                x:Name="Arena"
                StartInteraction="OnTouchStart"
                DragInteraction="OnTouchMove"
                EndInteraction="OnTouchEnd" />

            <Border
                x:Name="HintCard"
                Style="{StaticResource Card}"
                BackgroundColor="{DynamicResource SurfaceRaised}"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="24,0,24,40"
                InputTransparent="True">
                <Label x:Name="HintLabel" Style="{StaticResource Body}" HorizontalTextAlignment="Center" />
            </Border>

            <Border
                x:Name="Toast"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,18,0,0"
                Padding="18,8"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{DynamicResource SurfaceRaised}"
                InputTransparent="True"
                IsVisible="False">
                <Label x:Name="ToastLabel" TextColor="{DynamicResource Highlight}" FontFamily="OpenSansSemibold" FontSize="18" />
            </Border>

            <Label
                x:Name="CountdownLabel"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontFamily="OpenSansSemibold"
                FontSize="84"
                TextColor="{DynamicResource Text}"
                InputTransparent="True"
                IsVisible="False" />

            <Grid x:Name="PausePanel" IsVisible="False">
                <BoxView Color="Black" Opacity="0.55" />
                <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource SurfaceRaised}" VerticalOptions="Center" Margin="24" MaximumWidthRequest="380" Padding="24">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Paused" Style="{StaticResource Title}" HorizontalOptions="Center" />
                        <Button Text="Continue" Style="{StaticResource PrimaryButton}" Clicked="OnContinue" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Restart" Style="{StaticResource SecondaryButton}" Clicked="OnRestart" />
                            <Button Grid.Column="1" Text="Home" Style="{StaticResource SecondaryButton}" Clicked="OnHome" />
                        </Grid>
                        <Button x:Name="PauseRemoveAds" Text="Remove ads" Style="{StaticResource GhostButton}" Clicked="OnRemoveAds" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid x:Name="OverPanel" IsVisible="False">
                <BoxView Color="Black" Opacity="0.6" />
                <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource SurfaceRaised}" VerticalOptions="Center" Margin="20" MaximumWidthRequest="400" Padding="24">
                    <ScrollView>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="OverTitle" Text="Game over" Style="{StaticResource Title}" HorizontalOptions="Center" />
                            <Label x:Name="OverScore" FontFamily="OpenSansSemibold" FontSize="52" TextColor="{DynamicResource Accent}" HorizontalOptions="Center" />
                            <Label x:Name="OverDetails" Style="{StaticResource Body}" HorizontalTextAlignment="Center" />
                            <Border x:Name="CodeCard" Style="{StaticResource Card}" Padding="12,8" HorizontalOptions="Center">
                                <Label x:Name="OverCode" TextColor="{DynamicResource Highlight}" FontFamily="OpenSansSemibold" FontSize="15" CharacterSpacing="2" />
                            </Border>
                            <Button x:Name="PlayAgainButton" Text="Play again" Style="{StaticResource PrimaryButton}" Clicked="OnRestart" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Text="Share" Style="{StaticResource SecondaryButton}" Clicked="OnShare" />
                                <Button Grid.Column="1" Text="Home" Style="{StaticResource SecondaryButton}" Clicked="OnHome" />
                            </Grid>
                            <Button x:Name="OverRemoveAds" Text="Remove ads" Style="{StaticResource GhostButton}" Clicked="OnRemoveAds" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Grid>

        <!-- D pad. Kept at least 48 dp above the ad strip by its bottom margin plus the gap row. -->
        <Grid
            x:Name="DPad"
            Grid.Row="2"
            IsVisible="False"
            HorizontalOptions="Center"
            Margin="0,8,0,24"
            RowDefinitions="64,64,64"
            ColumnDefinitions="64,64,64"
            RowSpacing="6"
            ColumnSpacing="6">
            <Button Grid.Column="1" Text="&#x25B2;" Style="{StaticResource PadButton}" Pressed="OnPadUp" SemanticProperties.Description="Up" />
            <Button Grid.Row="1" Text="&#x25C0;" Style="{StaticResource PadButton}" Pressed="OnPadLeft" SemanticProperties.Description="Left" />
            <Button Grid.Row="1" Grid.Column="2" Text="&#x25B6;" Style="{StaticResource PadButton}" Pressed="OnPadRight" SemanticProperties.Description="Right" />
            <Button Grid.Row="2" Grid.Column="1" Text="&#x25BC;" Style="{StaticResource PadButton}" Pressed="OnPadDown" SemanticProperties.Description="Down" />
        </Grid>

        <!-- 24 dp gap and a 1 dp divider between play and the banner. Touches here do nothing. -->
        <Grid x:Name="AdGap" Grid.Row="3" HeightRequest="24">
            <BoxView HeightRequest="1" VerticalOptions="End" Color="{DynamicResource Stroke}" />
        </Grid>

        <controls:AdStrip x:Name="Ads" Grid.Row="4" InGame="True" />

        <ui:SheetHost x:Name="SheetLayer" Grid.RowSpan="5" />
    </Grid>
</ContentPage>
