<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Spec 2.0 asks for net11.0-android (API 37). .NET 11 is not final yet, so this build uses the
		     spec's fallback: .NET 10 LTS targeting API 36. Change to net11.0-android once .NET 11 ships. -->
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>TheSnake</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>The Snake</ApplicationTitle>
		<ApplicationId>com.vishvplus.thesnakegame</ApplicationId>
		<ApplicationDisplayVersion>0.3.2</ApplicationDisplayVersion>
		<ApplicationVersion>6</ApplicationVersion>

		<!-- Google Play services (basement 18.12, pulled in by Play Games and Nearby) needs Android 7.0 (API 24) or later. -->
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Phones (arm64, arm) and emulators (x64). -->
		<RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1410" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1410" BaseSize="160,160" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Xamarin.GooglePlayServices.Ads.Lite" Version="124.0.0.9" />
		<PackageReference Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.2" />
		<!-- Billing pulls in Fragment 1.9.0, while MAUI still brings Fragment.Ktx 1.8.8. Fragment 1.9 merged the
		     Ktx classes, so the two clash ("FragmentKt defined multiple times"). Keep both on 1.9.0. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.GooglePlayServices.Games.V2" Version="122.1.0" />
		<PackageReference Include="Xamarin.GooglePlayServices.Nearby" Version="119.5.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TheSnake.Core\TheSnake.Core.csproj" />
	</ItemGroup>

</Project>
